# Sjabloon voor .env, die zelf niet in git staat (zie .gitignore).
# Kopieer dit bestand naar .env en vul de drie waarden in, of laat
# python scripts/setup.py lokaal dat doen. Leeg laten kan niet: docker compose
# weigert dan te starten.

# Wachtwoord van de database (A-06). Genereer met:
#   python -c "import secrets; print(secrets.token_hex(32))"
POSTGRES_PASSWORD=

# Sleutel waarmee Flask sessiecookies ondertekent (A-05). Genereer met:
#   python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# Sleutel van 256 bits waarmee de app het TOTP-geheim versleutelt (A-09, MIT-17).
# Los van FLASK_SECRET_KEY. Wie hem kwijtraakt, moet tweestapsverificatie
# opnieuw instellen. Genereer met:
#   python -c "import secrets; print(secrets.token_hex(32))"
DATA_ENCRYPTION_KEY=

# Optioneel, alleen tijdens de hacking week: veel gebruikers achter één adres van school.
# THROTTLE_IP_MODE=hackweek: 100 foute wachtwoorden per adres per 15 minuten (anders 20),
#   en dan 5 minuten op slot zonder verdubbeling. Een onbekende waarde laat de app niet starten.
# THROTTLE_PAIR_EXEMPT_USERS=hackingweek: geen teller per naam per adres voor het demoaccount,
#   zodat één klasgenoot het niet voor iedereen op slot zet. De limiet per adres en die op de
#   code blijven gelden.
# THROTTLE_IP_MODE=strict
# THROTTLE_PAIR_EXEMPT_USERS=

# Alleen op Azure, als app-instelling; lokaal weglaten.
# TRUSTED_PROXIES: aantal proxies voor de app, voor het echte clientadres in de
#   poginglimieten. Meten bij de eerste uitrol: te laag en iedereen telt als het
#   adres van de proxy, te hoog en een aanvaller kiest zelf zijn adres.
# HTTPS_ONLY=1: de sessiecookie alleen over HTTPS.
# De database gebruikt daar TLS: zet ?sslmode=require achter DATABASE_URL.
