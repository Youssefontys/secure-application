# Sjabloon voor .env, die zelf niet in git staat (zie .gitignore).
# Kopieer dit bestand naar .env en vul beide waarden in. Leeg laten kan niet:
# docker compose weigert dan te starten.

# Wachtwoord van de database (A-06). Genereer met:
#   python -c "import secrets; print(secrets.token_hex(32))"
POSTGRES_PASSWORD=

# Sleutel waarmee Flask sessiecookies ondertekent (A-05). Genereer met:
#   python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=
