# Template for .env, which itself is not in git (see .gitignore).
# Copy this file to .env and fill in the four values, or let
# python scripts/deployment.py local do that. Leaving them empty is not possible: docker compose
# then refuses to start.

# Password of the database (A-06). Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
POSTGRES_PASSWORD=

# Password of the app role notes_app (A-10, MIT-27): the app logs in with it, not
# as the owner. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
APP_DB_PASSWORD=

# Key with which Flask signs session cookies (A-05). Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# Key of 256 bits with which the app encrypts the TOTP secret and the notes
# (A-09, MIT-17, MIT-18). Separate from FLASK_SECRET_KEY. Whoever loses or replaces it
# loses all notes and has to set up two-step verification again (MC-22).
# Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
DATA_ENCRYPTION_KEY=

# Optional, only during the hacking week: many users behind one school address.
# THROTTLE_IP_MODE=hackweek: 100 wrong passwords per address per 15 minutes (otherwise 20),
#   and then 5 minutes locked without doubling. An unknown value stops the app from starting.
# THROTTLE_PAIR_EXEMPT_USERS=hackingweek: no counter per name per address for the demo account,
#   so one classmate does not lock it for everyone. The limit per address and the one on the
#   code still apply.
# THROTTLE_IP_MODE=strict
# THROTTLE_PAIR_EXEMPT_USERS=

# Only on Azure; leave them out locally. Terraform (terraform/app.tf) sets them there itself:
# TRUSTED_PROXIES=1: Container Apps only puts the rightmost address in
#   X-Forwarded-For. Only 0 or 1 is allowed: with -1 or 2 an attacker picks their own
#   address. Another value stops the app from starting.
# HTTPS_ONLY: the session cookie only over HTTPS. On by default; locally
#   compose.yaml sets it to 0, because the app runs on HTTP there.
# DATABASE_URL with sslmode=verify-full: TLS with a check of certificate and
#   host name. Microsoft advises against require, because it does not stop a man-in-the-middle.
