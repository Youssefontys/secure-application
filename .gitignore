# De echte geheimen (A-05, A-06, A-09). Het sjabloon zonder waarden is .env.example.
.env

# Bytecode die Python maakt als je de code buiten de container draait.
__pycache__/

# Virtuele omgeving, als je de app of tests buiten Docker draait.
.venv/

# Cache van pytest, zodra er tests zijn.
.pytest_cache/

# De lokale regressietest: staat in de map, maar (nog) niet in de repo.
tests/regress.py

# Gemaakt door scripts/azuresetup*.py: subscription- en tenant-id van je Azure-omgeving.
backend.*.conf

# Uitvoer van de scanners (zie de profiles in compose.yaml).
scan/
