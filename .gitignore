# The real secrets (A-05, A-06, A-09, A-10). The template without values is .env.example.
.env

# Bytecode that Python makes when you run the code outside the container.
__pycache__/

# Virtual environment, if you run the app or tests outside Docker.
.venv/

# Cache of pytest, once there are pytest tests.
.pytest_cache/

# Made by scripts/setup_azure.py: subscription and tenant ID of your Azure environment.
backend.conf

# The report of ZAP, if you run the baseline yourself (see the README).
zap-report.*

# Terraform: providers, state and plans do not belong in git; .terraform.lock.hcl does (pinned hashes, MIT-03).
terraform/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
